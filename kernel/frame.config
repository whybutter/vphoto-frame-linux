# Merged over arch/arm/configs/sunxi_defconfig.
#
# Rule of thumb for =y vs =m: anything that needs a firmware file from the
# rootfs is a module (built in, it would ask before / is mounted and give up);
# the display path is built in, so the panel lights without waiting on udev.

# Display: TCON -> DSI -> D-PHY -> our panel, PWM backlight
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_VPHOTO_A00ZP101B187=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# GPU: Mali-400 MP2 through lima (Mesa's lima on the userspace side)
CONFIG_DRM_LIMA=m

# Power: AXP223 on RSB, regulators, power key; SoC thermal (the frame's only
# temperature, reported to HA as soc_temp)
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_SUN8I_THERMAL=y

# Storage: the TF card is the root; the eMMC is deliberately left out so this
# system can't so much as mount Android's partitions by accident.
CONFIG_MMC_SUNXI=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y

# Wi-Fi: RTL8723DS on SDIO (rtw88, mainline since 6.5). sunxi_defconfig has no
# wireless at all, so the parents come too.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_8723DS=m
# Alpine's linux-firmware-* ship rtw88/rtw8723d_fw.bin.zst, not .bin: without
# this the module loads and then can't find its firmware.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Touch: Silead GSL1680 (firmware from the rootfs, see kernel/README)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=m

# The OTG port as a USB Ethernet gadget: the way in when Wi-Fi isn't up yet.
# Same cable adb uses today; the Mac sees a CDC-ECM interface.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y

# The bridge reads the PIR line (not fitted on this unit, but the board has it)
# and drives nothing else directly.
CONFIG_GPIO_CDEV=y
CONFIG_DEVMEM=y

CONFIG_LOCALVERSION="-frame"
