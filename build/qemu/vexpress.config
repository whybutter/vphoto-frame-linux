# The boot-test kernel: vexpress-a9 (qemu) with what the frame's boot path relies
# on -- devtmpfs, MMC block naming, ext4/vfat, and NO uevent helper, like the
# frame. "-qemu" so it never loads the frame's modules from the rootfs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_ARMMMCI=y
CONFIG_MMC_BLOCK=y
# CONFIG_UEVENT_HELPER is not set
CONFIG_TMPFS=y
CONFIG_DUMMY=y
CONFIG_LOCALVERSION="-qemu"
# CONFIG_LOCALVERSION_AUTO is not set
