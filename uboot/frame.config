# Merged over q8_a33_tablet_800x480_defconfig: the A33 reference tablet is this
# board's closest relative (AXP223 on RSB, PWM0 backlight on PH0, card detect PB4,
# Silead on TWI0). U-Boot keeps the Q8's own device tree -- it only needs mmc0
# and the OTG port; the kernel gets ours from the card (see boot.cmd).

# DRAM exactly as the vendor's boot0 sets it ([dram_para] in vendor/sys_config.fex):
# DDR3 at 480 MHz. dcdc5 = 1.35 V says the chips are DDR3L. If the frame is
# flaky, 432 MHz is the first thing to try.
CONFIG_DRAM_CLK=480
CONFIG_DRAM_ZQ=15339
CONFIG_DRAM_ODT_EN=y
CONFIG_AXP_DCDC5_VOLT=1350

# Rails as the vendor runs them ([power_sply]). aldo1 is VCC-IO: the vendor's
# 3.3 V, not the Q8's 3.0 V.
CONFIG_AXP_ALDO1_VOLT=3300
CONFIG_AXP_ALDO3_VOLT=3000
CONFIG_AXP_DLDO1_VOLT=3300
CONFIG_AXP_DLDO2_VOLT=3300

# No U-Boot video: its sunxi driver does parallel RGB / LVDS / HDMI, and this
# panel is MIPI-DSI. The Q8's VIDEO_LCD_* settings would drive the wrong pins.
# CONFIG_VIDEO_SUNXI is not set
# ...and all of VIDEO: with VIDEO_SUNXI off, VIDEO_DT_SIMPLEFB stays implied and
# board.c then calls sunxi_simplefb_setup(), which only VIDEO_SUNXI builds -- a
# link error in 2026.07.
# CONFIG_VIDEO is not set

# The Q8 console is R_UART on PL2/PL3, and PL3 is this frame's IR receiver: a
# remote's noise on RX must not stop autoboot, so don't even look for a key.
CONFIG_BOOTDELAY=-2

# The OTG port as a USB *device*, so a booted U-Boot shows up on the Mac as a
# fastboot gadget -- the only way to see milestone 1 without a serial console.
# CONFIG_USB_MUSB_HOST is not set
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_FLASH=n
CONFIG_CMD_GPIO=y
